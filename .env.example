# OpenWeatherMap API Key (for weather & thermodynamics data)
OW_API_KEY=your_openweather_api_key_here

# OpenRouteService API Key (for directional routing coordinates)
ORS_API_KEY=your_openroute_service_api_key_here

# World Air Quality Index (WAQI) Token (for station PM2.5 feeds)
WAQI_TOKEN=your_waqi_api_token_here
